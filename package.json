{
  "name": "rx-postmessenger",
  "version": "3.0.0",
  "author": "Jeffrey Westerkamp",
  "repository": "git+https://github.com/JJWesterkamp/rx-postmessenger.git",
  "description": "Minimal RxJS adapter for the window.postMessage API for request-response streams and notification streams across frame windows.",
  "keywords": [
    "RxJS",
    "Browser",
    "iframe",
    "postMessage",
    "event",
    "request",
    "response",
    "mapped",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean:dist": "rm -rf dist",
    "clean:coverage": "rm -rf coverage",
    "dev": "tsc --project tsconfig.app.json --watch",
    "build": "npm run clean:dist && tsc --project tsconfig.app.json",
    "check": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.spec.json",
    "bump": "npx yarn version --new-version",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fmt": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxfmt && oxlint --fix",
    "coveralls": "cat ./coverage/lcov.info | coveralls"
  },
  "peerDependencies": {
    "rxjs": "6.x || 7.x"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.0.0",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "coveralls": "^3.1.1"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
